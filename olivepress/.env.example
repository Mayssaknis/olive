# ============================================================================
# OlivePress - variables d'environnement (modele)
# Copier en ".env" puis adapter. Ne JAMAIS commiter le fichier ".env".
#   cp .env.example .env
# ============================================================================

# ---- Base de donnees PostgreSQL ----
OLIVEPRESS_DB_PASSWORD=changez-moi

# ---- JWT : OBLIGATOIRE en production, 32 caracteres minimum ----
# Generer par ex. : openssl rand -base64 48
OLIVEPRESS_JWT_SECRET=remplacez-par-une-cle-aleatoire-de-32-caracteres-minimum

# ---- Compte administrateur initial ----
OLIVEPRESS_ADMIN_USER=admin
OLIVEPRESS_ADMIN_EMAIL=admin@olivepress.local
OLIVEPRESS_ADMIN_PASSWORD=changez-moi-aussi

# ---- CORS : origines autorisees du front web (separees par des virgules) ----
OLIVEPRESS_CORS_ORIGINS=http://localhost:5173

# ---- Anti brute-force sur la connexion ----
OLIVEPRESS_LOGIN_MAX_ATTEMPTS=5
OLIVEPRESS_LOGIN_WINDOW_MINUTES=15

# ---- Notifications push (Expo) : true = envoi reel aux appareils enregistres ----
OLIVEPRESS_PUSH_ENABLED=false
